/**
 * Reuses the 中国风 palette + .btn-primary/.btn-disabled/.section-title/
 * .divider/.empty-state helpers from app.wxss (see that file's header
 * comment for the palette reference).
 */

.start-point-row {
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.chip {
  display: inline-block;
  padding: 14rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 999px;
  font-size: 28rpx;
  color: #6B5B45;
  background: #EFE6CF;
}

.chip--active {
  background: #B7282E;
  color: #FBF6EA;
  font-weight: 600;
}

.selected-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.selected-item {
  display: flex;
  align-items: center;
  background: #FFFDF6;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(43, 36, 32, 0.08);
}

.selected-art {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.card-art--nature {
  background: linear-gradient(135deg, #4F7B52, #A9C77A);
}

.card-art--culture {
  background: linear-gradient(135deg, #8A2B2B, #C89B3C);
}

.selected-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  margin-left: 20rpx;
}

.selected-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2B2420;
}

.selected-category {
  font-size: 22rpx;
  color: #8A7A63;
  margin-top: 4rpx;
}

.remove-btn {
  font-size: 24rpx;
  color: #B7282E;
  border: 1px solid #B7282E;
  border-radius: 999px;
  padding: 8rpx 20rpx;
}

.plan-btn {
  margin: 24rpx 0;
}

.plan-result {
  margin-top: 8rpx;
}

.timeline {
  display: flex;
  flex-direction: column;
  padding-left: 8rpx;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  position: relative;
}

.timeline-item:not(:last-child)::before {
  content: '';
  position: absolute;
  left: 27rpx;
  top: 56rpx;
  bottom: -12rpx;
  width: 2px;
  background: rgba(183, 40, 46, 0.25);
}

.timeline-marker {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 50%;
  background: #B7282E;
  color: #FBF6EA;
  font-size: 26rpx;
  font-weight: 700;
  flex-shrink: 0;
  z-index: 1;
}

.timeline-body {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  padding-top: 6rpx;
}

.timeline-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2B2420;
}

.timeline-meta {
  font-size: 24rpx;
  color: #8A7A63;
  margin-top: 4rpx;
}

.summary-box {
  background: #FBF6EA;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin: 20rpx 0;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
}

.summary-label {
  font-size: 26rpx;
  color: #8A7A63;
}

.summary-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #B7282E;
}

.save-row {
  margin-bottom: 16rpx;
}

.save-input {
  background: #FFFDF6;
  border: 1px solid rgba(43, 36, 32, 0.12);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #2B2420;
}

.save-btn {
  margin-bottom: 24rpx;
}
