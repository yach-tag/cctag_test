# Copy this file to `.env` (gitignored) and fill in a real key.
#
# 高德开放平台 (Amap) Web服务 API key. Used by services/mapProvider.js to
# fetch real driving (and, where available, transit) route distance/duration
# from 高德's Direction API (v3/direction/driving,
# v3/direction/transit/integrated).
#
# If this is unset, empty, or the API call fails for any reason (bad key,
# network error, rate limit, no route found), the backend automatically
# falls back to the haversine-distance estimate — it will not crash.
AMAP_KEY=your_amap_key_here
